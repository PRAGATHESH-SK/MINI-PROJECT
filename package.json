{
  "name": "connecting-tech",
  "version": "1.0.0",
  "private": true,
  "description": "Connecting Tech - Industry & University Geofenced Internship Management Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "start": "npm --prefix server run start",
    "db:push": "npm --prefix server run prisma:push",
    "db:seed": "npm --prefix server run seed",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  }
}
